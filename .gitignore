# dependencies
node_modules/

# builds
dist/
.output/

# wasm — both the Rust build dir and wasm-pack's pkg/ are build artifacts:
# CI builds pkg/ from source (wasm job in .github/workflows/ci.yml), locally
# via `pnpm wasm`. public/ copies are regenerated by copy-assets.
wasm/pdfcore/target/
wasm/pdfcore/pkg/
public/wasm/
public/cmaps/
public/standard_fonts/

# env
.env
.env.local
.env.*.local

# logs / caches
*.log
.DS_Store
coverage/
.vite/

# playwright artifacts
test-results/
playwright-report/
e2e/fixtures/*
# The encrypted fixture is committed (byte-stable across Ghostscript
# versions — see e2e/make-fixtures.mjs): it must stay tracked.
!e2e/fixtures/encrypted.pdf
e2e/.tmp-input/
e2e/playwright-report/
core.*
